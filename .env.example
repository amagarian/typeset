# The Gemini API key lives in the OS keychain via the in-app Settings panel.
# No frontend env required for normal use.

# Optional dev-only overrides. Defaults baked into the app point
# at the production registry, so you only need these to override
# (e.g. staging).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
